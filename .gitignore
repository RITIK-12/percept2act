# macOS
.DS_Store

# Local reference material — not tracked
*.pdf

# Setup photos / camera captures
*.jpg
*.jpeg
*.heic
*.webp
*.png

# ...but allow committed diagrams and docs assets
!docs/**/*.png
!docs/**/*.jpg

# Recorded LeRobot datasets and training artifacts — too large to track
/datasets/
/experiments/

# Python
__pycache__/
*.py[cod]
.venv/
